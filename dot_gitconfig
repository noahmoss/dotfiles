[user]
  name = Noah Moss
  email = noahbmoss@gmail.com
[alias]
  st = status
  can = commit --amend --no-edit
  co = checkout
  br = branch
  cp = cherry-pick
  lg = log --oneline -n 10
  pf = push --force-with-lease
  draw = "-c core.pager=cat -c interactive.diffFilter=cat diff"
[credential]
  helper = osxkeychain
[pager]
  branch = false
[core]
  excludesfile = ~/.gitignore_global
  pager = delta
[interactive]
  diffFilter = delta --color-only
[include]
  path = ~/.config/delta/themes.gitconfig
[delta]
  features = collared-trogon
  hunk-header-decoration-style = "#4a9eff" box ul
  line-numbers-left-style = "#4a9eff"
  line-numbers-right-style = "#4a9eff"
  hunk-header-file-style = "bold #e0e0e0"
[merge]
  conflictstyle = zdiff3
[rerere]
	enabled = true
