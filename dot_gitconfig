[user]
  name = Noah Moss
  email = noahbmoss@gmail.com
[alias]
  st = status
  can = commit --amend --no-edit
  co = checkout
  br = branch
  cp = cherry-pick
  lg = log --oneline -n 10
[credential]
  helper = osxkeychain
[pager]
  branch = false
[core]
  excludesfile = ~/.gitignore_global
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  line-numbers = false
  file-decoration-style = none
  hunk-header-decoration-style = none
  syntax-theme = ansi
[merge]
  conflictstyle = zdiff3
[rerere]
	enabled = true
