# .inputrc
# This file configures Readline, the library that handles your typed input in
# many command-line programs.  You can set key bindings and configuration
# options ("variables") here.  See https://fburl.com/inputrc for more info.
set blink-matching-paren on
set colored-stats on

set editing-mode vi
# TODO: why do the following lines not work
set show-mode-in-prompt on
set vi-cmd-mode-string "\1\e[2 q\2"
set vi-ins-mode-string "\1\e[6 q\2"

"\C-p":previous-history
"\C-n":next-history
"\C-a.":beginning-of-line
"\C-e.":end-of-line
"\C-l":clear-screen
