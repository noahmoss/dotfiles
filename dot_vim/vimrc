" vimrc
" Author: Noah Moss

" leader keys
" let mapleader = "\<Space>"
" let maplocalleader=","

" turn off line wrapping
"set nowrap

" indentation
filetype plugin indent on
set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab

" syntax highlighting and color scheme
syntax on
set termguicolors

" transparent background
hi Normal guibg=NONE ctermbg=NONE

" line numbers
set number relativenumber " use hybrid of normal and relative line numbers
nnoremap <leader>n :set invnumber<cr>:set invrelativenumber<cr>

" remap :W to :w in case I type it accidentally
command W w

" misc ui config
set showcmd " show command at bottom right
set showmode " show editing mode in status
set cursorline " highlight current line

" interaction
set mouse+=a
set backspace=2 " non-restricted backspace in insert mode

" persistent undo
if !isdirectory($HOME."/.vim/undodir")
    call mkdir($HOME."/.vim/undodir", "p")
endif
set undodir=~/.vim/undodir
set undofile

" set swapfile directory
set dir=/tmp

" clipboard
set clipboard=unnamed

" autocomplete
set wildmenu " cycle through vim commands with <Tab>

" scroll
set scrolljump=5

" search
set ignorecase " ignore case while searching...
set smartcase  " ...unless search term contains a capital letter
set incsearch  " search as chars are entered
set hlsearch   " highlight search terms

" buffer behavior
set hidden "hide buffers instead of closing them

" quickly edit/reload the vimrc file
nnoremap <silent> <leader>ev :e ~/.vim/vimrc<cr>
nnoremap <silent> <leader>sv :source ~/.vim/vimrc<cr>:source $MYVIMRC<cr>

let g:netrw_dirhistmax = 0

" open new split panes to bottom and right
set splitbelow
set splitright

" command line settings
set history=200
cnoremap <C-p> <Up>
cnoremap <C-n> <Down>

" Cmd-T mapping
nnoremap <C-t> :GFiles<cr>

nnoremap <leader>c :VCoolor<cr>

" let g:airline_theme='base16'

" Fixes delay between keypresses in <ESC>O
" see https://github.com/vim/vim/issues/24
set timeout timeoutlen=5000 ttimeoutlen=100

" various filetype autocommands
augroup commentstrings
  autocmd!
  autocmd FileType c,cpp,java setlocal commentstring=//\ %s
  autocmd Filetype ocaml      setlocal commentstring=(*\ %s\ *)
augroup END

" quickly toggle QuickScope
nmap <leader>q <plug>(QuickScopeToggle)
xmap <leader>q <plug>(QuickScopeToggle)

" disable quote concealing in JSON files
let g:indentLine_setConceal = 0

" tex options
let g:tex_flavor = 'tex'

" Haskell
let g:haskell_indent_if = 3

" YAML
autocmd FileType yaml setlocal ts=2 sts=2 sw=2 expandtab

"  figure out better clojure indentation
let g:clojure_align_subforms = 1
let g:clojure_maxlines = 100
augroup set_lispwords
  autocmd!
  autocmd FileType clojure set lispwords+=do,testing,ns,when-not,when-let,reify
  autocmd FileType clojure set lispwords+=try,catch,finally,doto,binding,cond->,doseq
  autocmd FileType clojure set lispwords+=are,u/prog1,cond,condp
augroup END

autocmd FileType clojure set textwidth=120

" Disable autopairs for lisps and just use vim-sexp
autocmd Filetype lisp,scheme,clojure,lfe let b:AutoPairs = {}

" Enable rainbow parentheses for Clojure files
let g:rainbow_active = 1

" Trim whitespace on save
autocmd BufWritePre * :%s/\s\+$//e

" Auto-install vim-plug if not already installed
if empty(globpath($HOME . '/.vim/autoload', 'plug.vim'))
  silent execute '!curl -fLo ' . shellescape($HOME . '/.vim/autoload/plug.vim') . ' --create-dirs ' .
        \ 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * call plug#begin('~/.vim/plugged') | PlugInstall --sync | q
endif

" https://stackoverflow.com/questions/4292733/vim-creating-parent-directories-on-save
function s:MkNonExDir(file, buf)
    if empty(getbufvar(a:buf, '&buftype')) && a:file!~#'\v^\w+\:\/'
        let dir=fnamemodify(a:file, ':h')
        if !isdirectory(dir)
            call mkdir(dir, 'p')
        endif
    endif
endfunction
augroup BWCCreateDir
    autocmd!
    autocmd BufWritePre * :call s:MkNonExDir(expand('<afile>'), +expand('<abuf>'))
augroup END

