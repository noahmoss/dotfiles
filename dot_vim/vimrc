" Disable Conjure document mapping (K) in favor of the LSP
let g:conjure#mapping#doc_word = v:false

doautocmd FileType clojure

" plugins (using vim-plug) - install using <leader>1
nnoremap <silent><leader>1 :source ~/.vim/vimrc \| :PlugInstall<CR>
