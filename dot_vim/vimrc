" Minimal vanilla vimrc — works on a fresh vim with no plugins.
" Mirrors the basics of ~/.config/nvim/init.lua so muscle memory carries over.

" ---- Leader ----
let mapleader = " "
let maplocalleader = ","

" ---- Indentation ----
filetype plugin indent on
set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab

" ---- UI ----
syntax on
set number relativenumber
set cursorline
set showcmd
set showmode
set splitbelow
set splitright
set scrolljump=5

" Toggle hybrid line numbers
nnoremap <leader>n :set invnumber<cr>:set invrelativenumber<cr>

" ---- Search ----
set ignorecase
set smartcase
set incsearch
set hlsearch
nnoremap <silent> <Esc> :nohlsearch<cr>

" ---- Editing ----
set mouse+=a
set backspace=indent,eol,start
set clipboard=unnamed
set hidden
set wildmenu
set history=200

" ---- Persistent undo ----
if !isdirectory($HOME."/.vim/undodir")
    call mkdir($HOME."/.vim/undodir", "p")
endif
set undodir=~/.vim/undodir
set undofile

" Swap files in /tmp keep cwd clean.
set dir=/tmp

" Stop netrw from cluttering jumplist with directory history.
let g:netrw_dirhistmax = 0

" ---- Common typo ----
command W w

" ---- Window navigation (matches nvim) ----
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ---- Line-start/end on H/L (swap with default ^/$) ----
nnoremap H ^
nnoremap L $
nnoremap ^ H
nnoremap $ L
vnoremap H ^
vnoremap L $
vnoremap ^ H
vnoremap $ L

" ---- Cmdline history ----
cnoremap <C-p> <Up>
cnoremap <C-n> <Down>

" ---- Quickly edit/reload vimrc ----
nnoremap <silent> <leader>ev :e ~/.vim/vimrc<cr>
nnoremap <silent> <leader>sv :source ~/.vim/vimrc<cr>

" ---- Filetype tweaks ----
autocmd FileType yaml setlocal ts=2 sts=2 sw=2 expandtab
autocmd FileType rust setlocal ts=4 sts=4 sw=4
autocmd FileType go   setlocal ts=4 sts=4 sw=4 noexpandtab

" Trim trailing whitespace on save.
autocmd BufWritePre * :%s/\s\+$//e

" Create parent directories on :w if they don't exist.
augroup BWCCreateDir
    autocmd!
    autocmd BufWritePre * call s:MkNonExDir(expand('<afile>'), +expand('<abuf>'))
augroup END
function s:MkNonExDir(file, buf)
    if empty(getbufvar(a:buf, '&buftype')) && a:file !~# '\v^\w+\:\/'
        let dir = fnamemodify(a:file, ':h')
        if !isdirectory(dir)
            call mkdir(dir, 'p')
        endif
    endif
endfunction
