# Zsh-only interactive config; portable bits live in ~/.shellrc.

[ -f ~/.shellrc ] && source ~/.shellrc

# ---- History ----
HISTSIZE=1000000
SAVEHIST=1000000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
# Share history across terminals (zsh equivalent of bash's PROMPT_COMMAND trick).
setopt INC_APPEND_HISTORY SHARE_HISTORY

# ---- Completion ----
# -C skips the security check on $fpath (~100ms saved); fine for personal machines.
autoload -Uz compinit && compinit -C

# ---- fzf ----
command -v fzf >/dev/null && eval "$(fzf --zsh)"

# ---- Tool integrations ----
command -v rbenv >/dev/null && eval "$(rbenv init - --no-rehash zsh)"
[ -x "$HOME/.local/bin/mise" ] && eval "$($HOME/.local/bin/mise activate zsh)"
[ -f ~/.orbstack/shell/init.zsh ] && source ~/.orbstack/shell/init.zsh 2>/dev/null

# ---- Prompt + plugins ----
# Install:  brew install starship zsh-autosuggestions zsh-syntax-highlighting
command -v starship >/dev/null && eval "$(starship init zsh)"
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] \
    && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-syntax-highlighting must be sourced last.
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] \
    && source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ---- Local-only overrides (gitignored) ----
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
