# Bash-only interactive config; portable bits live in ~/.shellrc.

# Bash sometimes sources bashrc for non-interactive shells (e.g. scp); bail.
[[ $- != *i* ]] && return

[ -f ~/.shellrc ] && source ~/.shellrc

# ---- History ----
HISTFILESIZE=-1
HISTSIZE=1000000
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend
# Sync history across terminals on every prompt.
export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

# ---- Prompt ----
export PS1="\\t $ "

# ---- Vi-mode keybindings ----
bind -m vi-command 'Control-l: clear-screen'
bind -m vi-insert 'Control-l: clear-screen'

export BASH_SILENCE_DEPRECATION_WARNING=1

# ---- Completions ----
# Mac (Xcode CLT) and Linux fallback paths for git completion.
[ -f /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash ] \
    && source /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash
[ -f /usr/share/bash-completion/completions/git ] \
    && source /usr/share/bash-completion/completions/git
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

HEROKU_AC_BASH_SETUP_PATH=/Users/noahmoss/Library/Caches/heroku/autocomplete/bash_setup
[ -f "$HEROKU_AC_BASH_SETUP_PATH" ] && source "$HEROKU_AC_BASH_SETUP_PATH"

# ---- Tool integrations ----
command -v rbenv >/dev/null && eval "$(rbenv init - --no-rehash bash)"
[ -x "$HOME/.local/bin/mise" ] && eval "$($HOME/.local/bin/mise activate bash)"
[ -f ~/.orbstack/shell/init.bash ] && source ~/.orbstack/shell/init.bash 2>/dev/null

# ---- Local-only overrides (gitignored) ----
# Prefer ~/.shellrc.local for env vars that should apply to both shells.
[ -f ~/.bashrc.local ] && source ~/.bashrc.local
